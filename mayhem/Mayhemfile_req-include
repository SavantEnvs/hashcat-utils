# Mayhem target `req-include` — the hashcat-utils `req-include` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/req-include. Raw (non-libFuzzer, process-per-input) target:
# `req-include inc_mask < infile` — reads words on stdin. No `@@`, so Mayhem delivers the fuzz bytes on stdin.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: req-include

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/req-include/testsuite

cmds:
  - cmd: /mayhem/cli/req-include 3
    timeout: 5
