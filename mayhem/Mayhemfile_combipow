# Mayhem target `combipow` — the hashcat-utils `combipow` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/combipow. Raw (non-libFuzzer, process-per-input) target:
# `combipow file1` — the wordlist argument is the fuzz file.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: combipow

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/combipow/testsuite

cmds:
  - cmd: /mayhem/cli/combipow @@
    timeout: 5
