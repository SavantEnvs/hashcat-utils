# Mayhem target `combinatorX` — the hashcat-utils `combinatorX` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/combinatorX. Raw (non-libFuzzer, process-per-input) target:
# `combinatorX --file1 f --file2 f` — both required wordlists are the fuzz file.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: combinatorX

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/combinatorX/testsuite

cmds:
  - cmd: /mayhem/cli/combinatorX --file1 @@ --file2 @@
    timeout: 5
