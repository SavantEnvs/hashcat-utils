# Mayhem target `cutb` — the hashcat-utils `cutb` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/cutb. Raw (non-libFuzzer, process-per-input) target:
# `cutb offset [length] < infile` — reads words on stdin. No `@@`, so Mayhem delivers the fuzz bytes on stdin.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: cutb

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/cutb/testsuite

cmds:
  - cmd: /mayhem/cli/cutb 1 3
    timeout: 5
