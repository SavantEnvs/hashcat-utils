# Mayhem target `hcstatgen` — the hashcat-utils `hcstatgen` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/hcstatgen. Raw (non-libFuzzer, process-per-input) target:
# `hcstatgen outfile < dictionary` — reads the dictionary on stdin; the .hcstat table is written to the writable cwd. No `@@`, so Mayhem delivers the fuzz bytes on stdin.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: hcstatgen

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/hcstatgen/testsuite

cmds:
  - cmd: /mayhem/cli/hcstatgen ./hcstatgen.out
    timeout: 5
