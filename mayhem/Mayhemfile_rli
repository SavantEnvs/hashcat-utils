# Mayhem target `rli` — the hashcat-utils `rli` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/rli. Raw (non-libFuzzer, process-per-input) target:
# `rli infile outfile removefiles...` — infile and the removefile are the fuzz file; outfile goes to the writable cwd.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: rli

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/rli/testsuite

cmds:
  - cmd: /mayhem/cli/rli @@ ./rli.out @@
    timeout: 5
