# Mayhem target `hcstat2gen` — the hashcat-utils `hcstat2gen` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/hcstat2gen. Raw (non-libFuzzer, process-per-input) target:
# `hcstat2gen outfile < dictionary` — reads the dictionary on stdin; the .hcstat2 table is written to the writable cwd. No `@@`, so Mayhem delivers the fuzz bytes on stdin.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: hcstat2gen

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/hcstat2gen/testsuite

cmds:
  - cmd: /mayhem/cli/hcstat2gen ./hcstat2gen.out
    timeout: 5
