# Mayhem target `combinator3` — the hashcat-utils `combinator3` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/combinator3. Raw (non-libFuzzer, process-per-input) target:
# `combinator3 file1 file2 file3` — all three wordlist arguments are the fuzz file.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: combinator3

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/combinator3/testsuite

cmds:
  - cmd: /mayhem/cli/combinator3 @@ @@ @@
    timeout: 5
