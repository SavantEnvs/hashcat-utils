# Mayhem target `ngramX` — the hashcat-utils `ngramX` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/ngramX. Raw (non-libFuzzer, process-per-input) target:
# `ngramX <filename> <groupSize>` — the filename argument is the fuzz file.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: ngramX

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/ngramX/testsuite

cmds:
  - cmd: /mayhem/cli/ngramX @@ 2
    timeout: 5
