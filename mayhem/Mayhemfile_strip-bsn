# Mayhem target `strip-bsn` — the hashcat-utils `strip-bsn` command-line tool, one of the package's public
# utilities (src/Makefile `native:`), built sanitized (ASan+UBSan, halting) + SanCov + DWARF-3 by
# mayhem/build.sh at /mayhem/cli/strip-bsn. Raw (non-libFuzzer, process-per-input) target:
# `strip-bsn < infile` — reads lines on stdin. No `@@`, so Mayhem delivers the fuzz bytes on stdin.
# A slow or hanging input is bounded by Mayhem's own per-test limit, the explicit 5 s `timeout:` below (no in-process watchdog).
project: savantenvs/hashcat-utils
target: strip-bsn

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/strip-bsn/testsuite

cmds:
  - cmd: /mayhem/cli/strip-bsn
    timeout: 5
